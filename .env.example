# AgentNews 配置示例。
# 复制为 .env 后逐项替换：带 your- 前缀的值是占位符，不替换会在调用时鉴权失败。
# 如果某一项留空，config.py 会把它当作未配置，对应的功能即视为关闭。

# DeepSeek 模型
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=2
AGENT_MAX_TOOL_CALLS=16

# 联网搜索（Tavily MCP）
MCP_SEARCH_SERVER_URL=https://mcp.tavily.com/mcp
MCP_SEARCH_API_KEY=your-tavily-api-key
MCP_SEARCH_TIMEOUT=20

# 邮件推送（SMTP）：默认 465 隐式 TLS（163、QQ 等常用）；服务商要求 587 + STARTTLS 时
# 把 SMTP_PORT 改成 587、SMTP_USE_SSL 改成 false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=your-sender@example.com

# 本地运行时数据
APP_TIMEZONE=Asia/Shanghai
REPORT_ROOT=data/reports
SOURCE_ARCHIVE_ROOT=data/source_archive
TEMP_ROOT=data/tmp
SQLITE_PATH=data/agentnews.sqlite3
